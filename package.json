{
  "name": "@getparafe/a2a-extension",
  "version": "3.2.0",
  "description": "Parafé trust extension for the A2A protocol (A2A 1.0 and 0.3) — cryptographic agent identity, mutual authentication, and scoped consent carried in A2A message metadata",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/interop",
    "test:integration": "vitest run tests/integration",
    "prepublishOnly": "npm run build",
    "test:interop": "vitest run tests/interop"
  },
  "keywords": [
    "a2a",
    "agent-to-agent",
    "parafe",
    "trust",
    "identity",
    "consent",
    "agent",
    "ai",
    "google-a2a",
    "a2a-protocol",
    "a2a-extension"
  ],
  "author": "Parafe <hello@parafe.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getparafe/parafe-a2a-extension.git"
  },
  "homepage": "https://parafe.ai",
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@a2a-js/sdk": "^1.2.1",
    "express": "^5.2.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18"
  }
}
